{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openloops.invalid/contracts/model/analysis-output-v1",
  "title": "OpenLoops transient model hypotheses v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "claims": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "opaque_handle": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "evidence_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_handle", "component", "block_ordinal", "range_start", "range_end"],
      "properties": {
        "source_handle": {"$ref": "#/$defs/opaque_handle"},
        "component": {"enum": ["subject", "body_block", "quote_block", "sender", "to", "cc", "attachment_name", "link_label"]},
        "block_ordinal": {"type": "integer", "minimum": 0, "maximum": 65535},
        "range_start": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "range_end": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "temporal_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_evidence_index", "kind", "value"],
      "properties": {
        "text_evidence_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "kind": {"enum": ["date", "local_datetime", "relative", "event_relative", "soft_window"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "evidence", "waiting_party_handle", "related_loop_handles", "temporal", "confidence_micros", "ambiguity_codes"],
      "properties": {
        "claim_type": {"enum": ["request", "promise", "attribution", "question", "deadline_change", "possible_closure", "delegation", "modification"]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/evidence_range"}},
        "waiting_party_handle": {"oneOf": [{"$ref": "#/$defs/opaque_handle"}, {"type": "null"}]},
        "related_loop_handles": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_handle"}},
        "temporal": {"oneOf": [{"$ref": "#/$defs/temporal_hypothesis"}, {"type": "null"}]},
        "confidence_micros": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ambiguity_codes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["quote_scope", "identity", "delegation", "deadline", "relation", "cross_message", "insufficient_context", "semantic_conflict"]}}
      }
    }
  }
}
