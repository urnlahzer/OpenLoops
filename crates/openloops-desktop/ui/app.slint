import { Tokens } from "tokens.slint";
import { TitleBar, NavRail, StatusBar } from "chrome.slint";
import { SourcesScreen, StatusLine } from "sources.slint";
import { ReviewScreen, ReviewRow, MetaCell, ReviewPill, ScanStripModel, EvidenceCard, CompletionCard, ConversationRow, ReminderStateView } from "review.slint";
export { StatusLine } from "sources.slint";
export { ReviewRow, MetaCell, ReviewPill, ScanStripModel, EvidenceCard, CompletionCard, ConversationRow, ReminderStateView } from "review.slint";

export component AppWindow inherits Window {
    title: "OpenLoops";
    // Owner feedback item 5: the taskbar/title-bar icon. Path is relative to
    // this .slint file; `slint-build` resolves and embeds it at compile
    // time, so `build.rs` needs no extra include path for it. A pinned
    // taskbar shortcut's own icon would need an embedded exe resource --
    // that is out of scope here (see docs/native-setup.md).
    icon: @image-url("assets/openloops-256.png");
    min-width: Tokens.window-min-width;
    min-height: Tokens.window-min-height;
    preferred-width: Tokens.window-width;
    preferred-height: Tokens.window-height;
    background: Tokens.bg-canvas;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.font-14;

    in-out property <int> active-screen;
    in property <bool> busy;
    in property <bool> scanning;
    in property <string> busy-chip-text;
    in property <string> review-scan-chip-text;
    in property <bool> account-signed-in;
    in property <int> review-badge;
    in property <string> provider-name;
    in property <bool> provider-connected;
    in property <string> status-left;
    in property <string> status-center;
    in property <string> status-right;
    in property <bool> store-available;
    in property <string> settings-status;
    in property <bool> settings-succeeded;
    in-out property <string> client-id;
    in-out property <string> groups;
    in-out property <string> shared-mailboxes;
    in property <bool> own-inbox-accessible;
    in property <[StatusLine]> microsoft-lines;
    in-out property <int> provider-index;
    in-out property <string> api-key;
    in-out property <bool> show-key;
    in property <[string]> models;
    in-out property <int> model-index;
    in-out property <string> model-value;
    in-out property <int> ollama-plan-index;
    in property <[string]> ollama-plan-options;
    in-out property <string> openrouter-parallel;
    in-out property <bool> parallel-field-focused;
    in property <string> model-status;
    in property <bool> model-succeeded;
    in property <string> provider-disclosure;
    in property <string> key-placeholder;
    in property <string> load-models-label;
    in property <bool> can-check-microsoft;
    in property <bool> can-load-models;
    in property <bool> can-test-model;
    in property <bool> review-scanning;
    in property <bool> can-scan;
    in property <bool> can-rescan;
    in-out property <int> review-filter-index;
    in-out property <bool> show-handled;
    in property <string> show-handled-label;
    in property <[ReviewRow]> review-rows;
    in property <int> review-open-count;
    in property <ScanStripModel> scan-strip;
    in-out property <bool> coverage-open;
    in property <bool> review-has-analysis;
    in property <bool> review-no-usable-items;
    in property <string> review-no-usable-text;
    in property <bool> review-has-selection;
    in property <[ReviewPill]> review-pills;
    in property <string> review-title;
    in property <[MetaCell]> review-meta;
    in property <string> review-uncertainty;
    in property <string> review-action-status;
    in property <bool> review-action-status-succeeded;
    in property <bool> selected-open;
    in property <bool> selected-terminal;
    in property <bool> can-track;
    in property <bool> can-watch;
    in property <bool> can-remind;
    in property <bool> draft-open;
    in-out property <string> draft-title;
    in-out property <string> draft-when;
    in property <string> draft-scheduled-line;
    in property <bool> draft-valid;
    in property <ReminderStateView> reminder-state;
    in property <[EvidenceCard]> evidence-cards;
    in property <CompletionCard> completion-card;
    in property <string> conversation-title;
    in property <[ConversationRow]> conversation-rows;
    in property <string> todo-url;
    in property <bool> conversation-expanded-default;

    callback navigate(int);
    callback save-settings;
    callback reload-settings;
    callback forget-settings;
    callback client-id-edited(string);
    callback groups-edited(string);
    callback shared-edited(string);
    callback check-microsoft;
    callback provider-selected(int);
    callback key-edited(string);
    callback open-entra;
    callback open-key-page;
    callback load-models;
    callback model-selected(string);
    callback plan-selected(int);
    callback parallel-committed(string);
    callback test-model;
    callback scan-inboxes;
    callback stop-scan;
    callback rescan;
    callback clear-results;
    callback review-filter-selected(int);
    callback show-handled-toggled(bool);
    callback coverage-toggled(bool);
    callback select-review-row(int);
    callback move-review-selection(int);
    callback list-primary-action;
    callback review-decision(int);
    callback open-reminder;
    callback draft-title-edited(string);
    callback draft-when-edited(string);
    callback draft-in-hour;
    callback draft-tomorrow;
    callback create-reminder;
    callback cancel-reminder;
    callback reconcile-reminder(bool);
    callback open-external(string);

    VerticalLayout {
        spacing: 0px;
        TitleBar { scanning: root.scanning; scan-text: root.review-scan-chip-text.is-empty ? root.busy-chip-text : root.review-scan-chip-text; account-signed-in: root.account-signed-in; }
        HorizontalLayout { spacing: 0px; vertical-stretch: 1;
            NavRail { selected-index <=> root.active-screen; review-badge: root.review-badge; provider-name: root.provider-name; provider-connected: root.provider-connected; enabled: !root.busy; selected(index) => { root.navigate(index); } }
            if root.active-screen == 1: SourcesScreen {
                controls-enabled: !root.busy; store-available: root.store-available; settings-status: root.settings-status; settings-succeeded: root.settings-succeeded;
                client-id <=> root.client-id; groups <=> root.groups; shared-mailboxes <=> root.shared-mailboxes; own-inbox-accessible: root.own-inbox-accessible; microsoft-lines: root.microsoft-lines;
                provider-index <=> root.provider-index; api-key <=> root.api-key; show-key <=> root.show-key; models: root.models; model-index <=> root.model-index; model-value <=> root.model-value;
                ollama-plan-index <=> root.ollama-plan-index; ollama-plan-options: root.ollama-plan-options; openrouter-parallel <=> root.openrouter-parallel;
                parallel-field-focused <=> root.parallel-field-focused; model-status: root.model-status; model-succeeded: root.model-succeeded;
                provider-disclosure: root.provider-disclosure; key-placeholder: root.key-placeholder; load-models-label: root.load-models-label;
                can-check-microsoft: root.can-check-microsoft; can-load-models: root.can-load-models; can-test-model: root.can-test-model;
                save-settings => { root.save-settings(); } reload-settings => { root.reload-settings(); } forget-settings => { root.forget-settings(); }
                client-id-edited(value) => { root.client-id-edited(value); } groups-edited(value) => { root.groups-edited(value); } shared-edited(value) => { root.shared-edited(value); }
                check-microsoft => { root.check-microsoft(); } provider-selected(index) => { root.provider-selected(index); } key-edited(value) => { root.key-edited(value); }
                open-entra => { root.open-entra(); } open-key-page => { root.open-key-page(); }
                load-models => { root.load-models(); } model-selected(value) => { root.model-selected(value); } plan-selected(index) => { root.plan-selected(index); }
                parallel-committed(value) => { root.parallel-committed(value); } test-model => { root.test-model(); }
            }
            if root.active-screen == 0: ReviewScreen {
                busy: root.busy; review-scanning: root.review-scanning; can-scan: root.can-scan; can-rescan: root.can-rescan;
                filter-index <=> root.review-filter-index; show-handled <=> root.show-handled; show-handled-label: root.show-handled-label; rows: root.review-rows; open-count: root.review-open-count;
                scan-strip: root.scan-strip; coverage-open <=> root.coverage-open; has-analysis: root.review-has-analysis;
                no-usable-items: root.review-no-usable-items; no-usable-text: root.review-no-usable-text; has-selection: root.review-has-selection;
                pills: root.review-pills; title: root.review-title; meta: root.review-meta; uncertainty: root.review-uncertainty;
                action-status: root.review-action-status; action-status-succeeded: root.review-action-status-succeeded; selected-open: root.selected-open; selected-terminal: root.selected-terminal;
                can-track: root.can-track; can-watch: root.can-watch; can-remind: root.can-remind;
                draft-open: root.draft-open; draft-title <=> root.draft-title; draft-when <=> root.draft-when; draft-scheduled-line: root.draft-scheduled-line; draft-valid: root.draft-valid;
                reminder-state: root.reminder-state; evidence-cards: root.evidence-cards; completion-card: root.completion-card; conversation-title: root.conversation-title; conversation-rows: root.conversation-rows;
                todo-url: root.todo-url; conversation-expanded-default: root.conversation-expanded-default;
                scan-inboxes => { root.scan-inboxes(); } stop-scan => { root.stop-scan(); } rescan => { root.rescan(); } clear-results => { root.clear-results(); }
                filter-selected(index) => { root.review-filter-selected(index); } show-handled-toggled(value) => { root.show-handled-toggled(value); }
                coverage-toggled(value) => { root.coverage-toggled(value); } sources-link => { root.navigate(1); root.active-screen = 1; }
                select-row(handle) => { root.select-review-row(handle); } move-selection(delta) => { root.move-review-selection(delta); }
                list-primary-action => { root.list-primary-action(); }
                decision(value) => { root.review-decision(value); } open-reminder => { root.open-reminder(); }
                draft-title-edited(value) => { root.draft-title-edited(value); } draft-when-edited(value) => { root.draft-when-edited(value); }
                draft-in-hour => { root.draft-in-hour(); } draft-tomorrow => { root.draft-tomorrow(); } create-reminder => { root.create-reminder(); } cancel-reminder => { root.cancel-reminder(); }
                reconcile-reminder(exists) => { root.reconcile-reminder(exists); } open-external(url) => { root.open-external(url); }
            }
        }
        StatusBar { left-text: root.status-left; center-text: root.status-center; right-text: root.status-right; }
    }
}
