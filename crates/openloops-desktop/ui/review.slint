import { Tokens } from "tokens.slint";
import { PrimaryButton, SecondaryButton, SubtleButton, OutlineButton, LinkButton, Segmented, Pill, Callout, Field, Disclosure, Avatar, ProgressBar, Checkbox } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct ReviewRow {
    handle: int,
    group-title: string,
    group-kind: string,
    group-count: int,
    first-in-group: bool,
    selected: bool,
    action: string,
    waiting-source: string,
    aging-status: string,
    aging-kind: string,
    date: string,
}

export struct MetaCell { label: string, value: string }
export struct ReviewPill { text: string, kind: string }
export struct EvidenceCard { label: string, sender: string, time: string, quote: string, context: string, subject-note: string, url: string }
export struct CompletionCard { state: string, label: string, sender: string, time: string, quote: string, cross-thread: bool, url: string }
export struct ConversationRow { initials: string, sender: string, meta: string, body: string, sent: bool, quoted-history: string }
export struct ReminderStateView { state: string, text: string, marker: string }
export struct ScanStripModel {
    state: string,
    title: string,
    conversation: string,
    messages: string,
    elapsed: string,
    provider: string,
    summary: string,
    coverage-label: string,
    coverage-notes: string,
    progress: float,
    incomplete: bool,
}

component WrappedText {
    in property <string> text;
    in property <color> color: Tokens.text-2;
    in property <length> size: Tokens.font-13;
    in property <int> weight: 400;
    width: 100%;
    Rectangle { width: 100%; height: label.preferred-height;
        label := Text { width: 100%; text: root.text; color: root.color; font-size: root.size; font-weight: root.weight; wrap: word-wrap; }
    }
}

component GroupDot inherits Rectangle { in property <string> kind;
    width: Tokens.group-dot-size; height: Tokens.group-dot-size;
    background: kind == "danger" ? Tokens.danger : kind == "warning" ? Tokens.warning : kind == "brand" ? Tokens.brand : kind == "success" ? Tokens.success : Tokens.text-3;
    border-radius: Tokens.radius-pill;
}

component MetaBlock {
    in property <MetaCell> cell;
    min-width: Tokens.review-meta-min-width;
    horizontal-stretch: 1;
    VerticalLayout { spacing: Tokens.space-1;
        Text { text: root.cell.label; color: Tokens.text-2; font-size: Tokens.font-13; }
        WrappedText { text: root.cell.value; color: Tokens.text-1; weight: 600; }
    }
}

export component ReviewScreen {
    in property <bool> busy;
    in property <bool> review-scanning;
    in property <bool> can-scan;
    in property <bool> can-rescan;
    in-out property <int> filter-index;
    in-out property <bool> show-handled;
    in property <string> show-handled-label;
    in property <[ReviewRow]> rows;
    in property <int> open-count;
    in property <ScanStripModel> scan-strip;
    in-out property <bool> coverage-open;
    in property <bool> has-analysis;
    in property <bool> no-usable-items;
    in property <string> no-usable-text;
    in property <bool> has-selection;
    in property <[ReviewPill]> pills;
    in property <string> title;
    in property <[MetaCell]> meta;
    in property <string> uncertainty;
    in property <string> action-status;
    in property <bool> action-status-succeeded;
    in property <bool> selected-open;
    in property <bool> selected-terminal;
    in property <bool> can-track;
    in property <bool> can-watch;
    in property <bool> can-remind;
    in property <bool> draft-open;
    in-out property <string> draft-title;
    in-out property <string> draft-when;
    in property <string> draft-scheduled-line;
    in property <bool> draft-valid;
    in property <ReminderStateView> reminder-state;
    in property <string> todo-url;
    in property <[EvidenceCard]> evidence-cards;
    in property <CompletionCard> completion-card;
    in property <string> conversation-title;
    in property <[ConversationRow]> conversation-rows;
    // Set once at startup by the `--preview-review` screenshot fixture only;
    // normal runs never touch this, so the Disclosure still starts collapsed
    // and stays fully user-toggled from then on (see "Slint facts": a
    // runtime assignment -- the Disclosure's own click handler -- drops this
    // binding after the first toggle).
    in property <bool> conversation-expanded-default: false;

    callback scan-inboxes;
    callback stop-scan;
    callback rescan;
    callback clear-results;
    callback filter-selected(int);
    callback show-handled-toggled(bool);
    callback coverage-toggled(bool);
    callback sources-link;
    callback select-row(int);
    callback move-selection(int);
    callback list-primary-action;
    callback decision(int);
    callback open-reminder;
    callback draft-title-edited(string);
    callback draft-when-edited(string);
    callback draft-in-hour;
    callback draft-tomorrow;
    callback create-reminder;
    callback cancel-reminder;
    callback reconcile-reminder(bool);
    callback open-external(string);

    VerticalLayout { spacing: 0px;
        Rectangle { height: Tokens.command-height; background: Tokens.bg-bar;
            HorizontalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-2;
                // N1: the glyph lives inside the button's own label text, not
                // as a sibling Text sitting outside the clickable/focusable
                // area.
                if root.review-scanning: SecondaryButton { text: "■ Stop scan"; accessible-name: "Stop scan"; clicked => { root.stop-scan(); } }
                if !root.review-scanning: PrimaryButton { text: "Scan inboxes"; enabled: root.can-scan; clicked => { root.scan-inboxes(); } }
                SubtleButton { text: "Rescan loaded mail"; enabled: root.can-rescan; clicked => { root.rescan(); } }
                SubtleButton { text: "Clear results and mail"; enabled: !root.busy; clicked => { root.clear-results(); } }
                Rectangle { horizontal-stretch: 1; }
                Segmented { width: Tokens.review-filter-width; options: ["All", "Mine", "Team"]; selected-index <=> root.filter-index; accessible-name: "Review filter"; enabled: !root.busy; selected(index) => { root.filter-selected(index); } }
                Checkbox { text: root.show-handled-label; checked <=> root.show-handled; enabled: !root.busy; toggled(value) => { root.show-handled-toggled(value); } }
            }
            // N3: one bottom hairline, not a four-side border.
            Rectangle { y: parent.height - Tokens.hairline; height: Tokens.hairline; background: Tokens.stroke-1; }
        }

        if root.scan-strip.state == "scanning": Rectangle { background: Tokens.brand-subtle; height: scanning-strip.preferred-height;
            scanning-strip := VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-1;
                // X8: phase/conversation/messages/elapsed share one row; the
                // provider disclosure sentence gets its own row beneath so it
                // wraps at the strip's own width instead of first laying out
                // at its unwrapped natural width alongside the counters.
                HorizontalLayout { spacing: Tokens.space-4;
                    Text { text: root.scan-strip.title; color: Tokens.brand; font-size: Tokens.font-13; font-weight: 600; }
                    Text { text: root.scan-strip.conversation; color: Tokens.text-1; font-size: Tokens.font-13; }
                    Text { text: root.scan-strip.messages; color: Tokens.text-2; font-size: Tokens.font-13; }
                    Text { text: root.scan-strip.elapsed; color: Tokens.text-2; font-size: Tokens.font-13; }
                    Rectangle { horizontal-stretch: 1; }
                }
                WrappedText { text: "Message text and participants go to your chosen model at " + root.scan-strip.provider + ". Attachments are not sent."; color: Tokens.text-2; size: Tokens.font-11; }
                ProgressBar { value: root.scan-strip.progress; accessible-name: root.scan-strip.messages; }
                if !root.scan-strip.summary.is-empty: WrappedText { text: root.scan-strip.summary; color: Tokens.warning; size: Tokens.font-11; }
            }
        }
        if root.scan-strip.state == "finished": Rectangle { background: Tokens.bg-surface; height: finished-strip.preferred-height;
            finished-strip := VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-2;
                HorizontalLayout { spacing: Tokens.space-2;
                    GroupDot { kind: root.scan-strip.incomplete ? "warning" : "success"; }
                    Text { text: root.scan-strip.title; color: root.scan-strip.incomplete ? Tokens.warning : Tokens.success; font-size: Tokens.font-13; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    LinkButton { text: root.scan-strip.coverage-label; enabled: !root.busy; clicked => { root.coverage-open = !root.coverage-open; root.coverage-toggled(root.coverage-open); } }
                }
                // On its own row (the VerticalLayout's cross-axis width, not a
                // HorizontalLayout main-axis share) so it wraps at the strip's
                // own inner edge instead of first laying out at its unwrapped
                // natural width alongside the title and link button.
                WrappedText { text: root.scan-strip.summary; color: Tokens.text-2; }
                if root.coverage-open: Callout { kind: "warning"; text: root.scan-strip.coverage-notes; }
            }
            // N3: one bottom hairline, not a four-side border.
            Rectangle { y: parent.height - Tokens.hairline; height: Tokens.hairline; background: Tokens.stroke-1; }
        }
        if root.scan-strip.state == "warning": Rectangle { background: Tokens.warning-bg; height: warning-strip.preferred-height;
            warning-strip := VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-2;
                HorizontalLayout { spacing: Tokens.space-2; alignment: start;
                    GroupDot { kind: "warning"; }
                    Text { text: root.scan-strip.title; color: Tokens.warning; font-size: Tokens.font-13; font-weight: 600; vertical-alignment: center; }
                }
                WrappedText { text: root.scan-strip.summary; color: Tokens.warning; }
            }
            // N3: one bottom hairline, not a four-side border.
            Rectangle { y: parent.height - Tokens.hairline; height: Tokens.hairline; background: Tokens.warning-stroke; }
        }
        if root.scan-strip.state == "idle": Rectangle { background: Tokens.bg-surface; height: idle-strip.preferred-height;
            idle-strip := VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-1;
                WrappedText { text: "Scan the last 30 days of Inbox and Sent Items, plus configured Groups and shared mailboxes. Each conversation is checked for expectations and later replies."; color: Tokens.text-1; }
                WrappedText { text: "Message text and participants go to your chosen model at " + root.scan-strip.provider + ". Attachments are not sent."; }
                LinkButton { text: "Scan scope and data sent to the model provider"; enabled: !root.busy; clicked => { root.sources-link(); } }
            }
            // N3: one bottom hairline, not a four-side border.
            Rectangle { y: parent.height - Tokens.hairline; height: Tokens.hairline; background: Tokens.stroke-1; }
        }

        HorizontalLayout { spacing: 0px; vertical-stretch: 1;
            Rectangle { width: Tokens.review-list-width; background: Tokens.bg-list;
                VerticalLayout { spacing: 0px;
                    Rectangle { min-height: Tokens.command-height;
                        HorizontalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; spacing: Tokens.space-2;
                            Text { text: "Who is waiting on you · " + root.open-count + " open"; color: Tokens.text-1; font-size: Tokens.font-16; font-weight: 600; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // N3: one bottom hairline, not a four-side border.
                        Rectangle { y: parent.height - Tokens.hairline; height: Tokens.hairline; background: Tokens.stroke-1; }
                    }
                    list-focus := FocusScope {
                        vertical-stretch: 1; accessible-role: list; accessible-label: "Review expectations"; accessible-item-count: root.rows.length;
                        key-pressed(event) => {
                            if root.busy { return reject; }
                            if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
                            if event.text == Key.DownArrow { root.move-selection(1); return accept; }
                            if event.text == Key.Return { root.list-primary-action(); return accept; }
                            return reject;
                        }
                        ScrollView { width: 100%; height: 100%; viewport-width: self.visible-width;
                            VerticalLayout { width: 100%; spacing: 0px; alignment: start;
                                for row[row-index] in root.rows: VerticalLayout { width: 100%; spacing: 0px;
                                    if row.first-in-group: Rectangle { min-height: Tokens.click-min;
                                        HorizontalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; spacing: Tokens.space-2;
                                            GroupDot { kind: row.group-kind; }
                                            Text { text: row.group-title; color: Tokens.text-2; font-size: Tokens.font-13; font-weight: 600; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: row.group-count; color: Tokens.text-3; font-size: Tokens.font-11; vertical-alignment: center; }
                                        }
                                    }
                                    // Explicit `height` (not `min-height`) bound to
                                    // `row-content`'s own preferred height: `item` is a
                                    // plain Rectangle inside a VerticalLayout with
                                    // `alignment: start`, so without this it renders at
                                    // exactly `review-row-min-height` regardless of
                                    // content, clipping the bottom padding whenever
                                    // "Waiting: …" wraps to two lines.
                                    item := Rectangle { height: max(Tokens.review-row-min-height, row-content.preferred-height); background: row.selected ? Tokens.brand-subtle : mouse.has-hover ? Tokens.bg-canvas : Tokens.transparent; accessible-role: list-item; accessible-label: row.action; accessible-item-selectable: true; accessible-item-selected: row.selected; accessible-item-index: row-index;
                                        // Measured off-layout (explicit x/y excludes it from the row's
                                        // HorizontalLayout) purely to decide whether the date fits beside
                                        // the title on one line or needs its own row above it.
                                        date-probe := Text { x: 0px; y: 0px; visible: false; text: row.date; font-size: Tokens.font-11; }
                                        private property <bool> date-fits-inline: date-probe.preferred-width <= Tokens.review-row-date-max-inline;
                                        Rectangle { x: 0px; y: 0px; width: Tokens.review-row-bar-width; height: parent.height; background: row.selected ? Tokens.brand : row.aging-kind == "danger" ? Tokens.danger : row.aging-kind == "brand" ? Tokens.brand : row.aging-kind == "success" ? Tokens.success : Tokens.text-3; }
                                        // `Tokens.text-2`, not `text-3`, for this row's own date/aging
                                        // text: this row can sit on the hover tint `Tokens.bg-canvas`
                                        // (spec §4.3's row hover colour), where `text-3` falls to
                                        // 4.35:1 -- below the 4.5:1 §7 requires -- while `text-2` clears
                                        // it on every row background this list uses (see the T5
                                        // contrast audit in the branch's task report).
                                        row-content := HorizontalLayout { padding-left: Tokens.space-3; padding-right: Tokens.space-3; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-2;
                                            VerticalLayout { horizontal-stretch: 1; spacing: Tokens.space-1; alignment: start;
                                                if !item.date-fits-inline: Text { text: row.date; color: Tokens.text-2; font-size: Tokens.font-11; horizontal-alignment: right; width: 100%; wrap: no-wrap; }
                                                HorizontalLayout { width: 100%; spacing: Tokens.space-2;
                                                    WrappedText { text: row.action; color: Tokens.text-1; weight: 600; horizontal-stretch: 1; width: 100%; }
                                                    if item.date-fits-inline: Text { text: row.date; color: Tokens.text-2; font-size: Tokens.font-11; horizontal-alignment: right; horizontal-stretch: 0; wrap: no-wrap; }
                                                }
                                                WrappedText { text: row.waiting-source; }
                                                WrappedText { text: row.aging-status; color: row.aging-kind == "danger" ? Tokens.danger : Tokens.text-2; size: Tokens.font-11; }
                                            }
                                        }
                                        mouse := TouchArea { enabled: !root.busy; clicked => { list-focus.focus(); root.select-row(row.handle); } }
                                    }
                                }
                                if root.rows.length == 0: Rectangle { min-height: Tokens.review-row-min-height * 3;
                                    Text { width: parent.width - 2 * Tokens.space-5; x: Tokens.space-5; text: "No open expectations match this filter. Missing replies in the scanned folders never prove work is finished."; color: Tokens.text-2; font-size: Tokens.font-13; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        if list-focus.has-focus: Rectangle { x: -Tokens.focus-ring; y: -Tokens.focus-ring; width: parent.width + 2 * Tokens.focus-ring; height: parent.height + 2 * Tokens.focus-ring; border-width: Tokens.focus-ring; border-color: Tokens.brand; }
                    }
                }
                // N3: the meaningful edge here is the divider against the reading
                // pane, so one right-edge hairline rather than a four-side border.
                Rectangle { x: parent.width - Tokens.hairline; width: Tokens.hairline; background: Tokens.stroke-1; }
            }

            Rectangle { background: Tokens.bg-surface; horizontal-stretch: 1;
                ScrollView { width: 100%; height: 100%; viewport-width: self.visible-width;
                    VerticalLayout { width: 100%; padding-left: Tokens.pane-gutter-x; padding-right: Tokens.pane-gutter-x; padding-top: Tokens.pane-gutter-y; padding-bottom: Tokens.pane-gutter-y; spacing: Tokens.review-section-gap; alignment: start;
                        reading-column := Rectangle { horizontal-stretch: 1; max-width: Tokens.review-reading-max-width;
                            VerticalLayout { width: 100%; spacing: Tokens.review-section-gap; alignment: start;
                                if root.no-usable-items: WrappedText { text: root.no-usable-text; color: Tokens.text-2; size: Tokens.font-14; }
                                if root.has-analysis && !root.no-usable-items && !root.has-selection: WrappedText { text: "No open expectations match this filter. Missing replies in the scanned folders never prove work is finished."; color: Tokens.text-2; size: Tokens.font-14; }
                                // X2: the reading pane has no selected-card branch to host
                                // `action-status` once results are cleared (no analysis, no
                                // selection), so a status set outside a decision -- "Results and
                                // mail cleared from memory..." -- would otherwise never render.
                                // Same colour rule as the selected-card copy below.
                                if !root.has-selection && !root.action-status.is-empty: WrappedText { text: root.action-status; color: root.action-status-succeeded ? Tokens.success : Tokens.warning; size: Tokens.font-13; }
                                if root.has-selection: VerticalLayout { width: 100%; spacing: Tokens.review-section-gap; alignment: start;
                                    HorizontalLayout { width: 100%; spacing: Tokens.space-2; alignment: start; for pill in root.pills: Pill { text: pill.text; kind: pill.kind; } }
                                    WrappedText { text: root.title; color: Tokens.text-1; size: Tokens.font-22; weight: 600; }
                                    meta-card := Rectangle { background: Tokens.bg-bar; border-radius: Tokens.radius-6;
                                        // X9: column count follows the reading column's own width
                                        // (stable regardless of the grid's own content) rather than a
                                        // fixed 2, so the card uses the width it actually has -- one
                                        // column when squeezed, up to four when there is room.
                                        private property <int> cols: max(1, min(4, floor(reading-column.width / Tokens.meta-col-min)));
                                        GridLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-3; padding-bottom: Tokens.space-3; spacing: Tokens.space-3;
                                            for cell[index] in root.meta: MetaBlock { row: index / meta-card.cols; col: mod(index, meta-card.cols); cell: cell; }
                                        }
                                    }
                                    if !root.uncertainty.is-empty: Rectangle { width: 100%; background: Tokens.warning-bg; border-color: Tokens.warning-stroke; border-width: Tokens.hairline; border-radius: Tokens.radius-4; accessible-role: AccessibleRole.text; accessible-label: "Uncertainty: " + root.uncertainty;
                                        VerticalLayout { padding-left: Tokens.space-3; padding-right: Tokens.space-3; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-1; alignment: start;
                                            Text { text: "Uncertainty:"; color: Tokens.warning; font-size: Tokens.font-13; font-weight: 600; }
                                            WrappedText { text: root.uncertainty; color: Tokens.warning; }
                                        }
                                    }
                                    VerticalLayout { width: 100%; spacing: Tokens.space-2; alignment: start;
                                        // Decision callback codes are defined once in slint_review.rs.
                                        // Two rows, not one: an undecided Team-owned card shows Track
                                        // *and* Watch alongside all three terminal actions, five buttons
                                        // that do not fit one row at the reading pane's width; splitting
                                        // unconditionally (row one hidden when neither applies) keeps this
                                        // from ever silently overflowing regardless of which combination
                                        // of can-track/can-watch is in play.
                                        if root.selected-open && (root.can-track || root.can-watch): HorizontalLayout { width: 100%; spacing: Tokens.space-2; alignment: start;
                                            if root.can-track: PrimaryButton { text: "Track — this is mine"; enabled: !root.busy; clicked => { root.decision(1); } }
                                            if root.can-watch: SecondaryButton { text: "Keep an eye on this"; enabled: !root.busy; clicked => { root.decision(4); } }
                                        }
                                        if root.selected-open: HorizontalLayout { width: 100%; spacing: Tokens.space-2; alignment: start;
                                            SecondaryButton { text: "Handled"; enabled: !root.busy; clicked => { root.decision(2); } }
                                            SecondaryButton { text: "Not mine / dismiss"; enabled: !root.busy; clicked => { root.decision(3); } }
                                            SecondaryButton { text: "No longer relevant"; enabled: !root.busy; clicked => { root.decision(5); } }
                                        }
                                        if root.selected-open: HorizontalLayout { width: 100%; Rectangle { horizontal-stretch: 1; } OutlineButton { text: "Set To Do reminder…"; enabled: root.can-remind; clicked => { root.open-reminder(); } } }
                                        // X3 (replaces the earlier egui-parity plan, S5): §4.5 and the
                                        // Companion show both actions on every closed card --
                                        // terminal (Handled/Dismissed/No longer relevant) and
                                        // auto-resolved alike -- not "Reopen" only for terminal
                                        // decisions and "Still open" only for the rest. Recorded as a
                                        // deliberate widening of the old egui behaviour in
                                        // docs/inbox-review.md.
                                        if !root.selected-open: HorizontalLayout { width: 100%; spacing: Tokens.space-2; alignment: start;
                                            PrimaryButton { text: "Reopen for review"; enabled: !root.busy; clicked => { root.decision(0); } }
                                            SecondaryButton { text: "Still open — track it"; enabled: !root.busy; clicked => { root.decision(1); } }
                                        }
                                    }
                                    if !root.action-status.is-empty: WrappedText { text: root.action-status; color: root.action-status-succeeded ? Tokens.success : Tokens.warning; size: Tokens.font-13; }
                                    if root.draft-open: draft-focus := FocusScope {
                                        width: 100%;
                                        init => { self.focus(); }
                                        key-pressed(event) => { if event.text == Key.Escape { root.cancel-reminder(); return accept; } return reject; }
                                        Rectangle { width: 100%; height: draft-body.preferred-height; background: Tokens.brand-panel; border-color: Tokens.brand-stroke; border-width: Tokens.hairline; border-radius: Tokens.radius-6;
                                            draft-body := VerticalLayout { padding-left: Tokens.card-pad-x; padding-right: Tokens.card-pad-x; padding-top: Tokens.space-4; padding-bottom: Tokens.space-4; spacing: Tokens.space-3; alignment: start;
                                                WrappedText { text: "Review your Microsoft To Do reminder"; color: Tokens.text-1; size: Tokens.font-16; weight: 600; }
                                                WrappedText { text: "Creates one task in your personal default Tasks list. Only the title, reminder time, and an opaque OpenLoops reference are sent to Microsoft. This requires delegated Tasks.ReadWrite and a separate browser sign-in."; }
                                                if reading-column.width >= Tokens.review-reading-max-width: HorizontalLayout { spacing: Tokens.space-3;
                                                    Field { label: "Task title"; value <=> root.draft-title; enabled: !root.busy; horizontal-stretch: 2; edited(value) => { root.draft-title-edited(value); } }
                                                    Field { label: "Remind me at (local time)"; placeholder: "YYYY-MM-DD HH:MM"; value <=> root.draft-when; monospace: true; enabled: !root.busy; horizontal-stretch: 1; edited(value) => { root.draft-when-edited(value); } }
                                                }
                                                if reading-column.width < Tokens.review-reading-max-width: VerticalLayout { spacing: Tokens.space-3;
                                                    Field { label: "Task title"; value <=> root.draft-title; enabled: !root.busy; edited(value) => { root.draft-title-edited(value); } }
                                                    Field { label: "Remind me at (local time)"; placeholder: "YYYY-MM-DD HH:MM"; value <=> root.draft-when; monospace: true; enabled: !root.busy; edited(value) => { root.draft-when-edited(value); } }
                                                }
                                                HorizontalLayout { spacing: Tokens.space-2;
                                                    SecondaryButton { text: "In one hour"; enabled: !root.busy; clicked => { root.draft-in-hour(); } }
                                                    SecondaryButton { text: "Tomorrow at 9 am"; enabled: !root.busy; clicked => { root.draft-tomorrow(); } }
                                                    Text { text: root.draft-scheduled-line; color: root.draft-valid ? Tokens.text-2 : Tokens.danger; font-size: Tokens.font-13; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                                                }
                                                WrappedText { text: "This time is your choice, separate from the email deadline. Microsoft To Do controls alert delivery, including when OpenLoops is closed. A failed or uncertain write is never retried automatically."; }
                                                HorizontalLayout { spacing: Tokens.space-2; alignment: start;
                                                    PrimaryButton { text: "Create this reminder in Microsoft To Do"; enabled: !root.busy && root.draft-valid; clicked => { root.create-reminder(); } }
                                                    SecondaryButton { text: "Cancel"; enabled: !root.busy; clicked => { root.cancel-reminder(); } }
                                                }
                                            }
                                        }
                                    }
                                    if root.reminder-state.state == "created": Callout { kind: "success"; text: root.reminder-state.text; accessible-name: root.reminder-state.text;
                                        HorizontalLayout { spacing: Tokens.space-2;
                                            Rectangle { horizontal-stretch: 1; }
                                            LinkButton { text: "Open Microsoft To Do"; enabled: !root.busy; clicked => { root.open-external(root.todo-url); } }
                                        }
                                    }
                                    if root.reminder-state.state == "attempted": Callout { kind: "warning"; text: root.reminder-state.text; accessible-name: root.reminder-state.text;
                                        Text { text: root.reminder-state.marker; color: Tokens.warning; font-family: Tokens.mono-font-family; font-size: Tokens.font-13; wrap: char-wrap; width: 100%; }
                                        HorizontalLayout { spacing: Tokens.space-2;
                                            Rectangle { horizontal-stretch: 1; }
                                            LinkButton { text: "Inspect Microsoft To Do"; enabled: !root.busy; clicked => { root.open-external(root.todo-url); } }
                                        }
                                        HorizontalLayout { spacing: Tokens.space-2; alignment: start;
                                            SecondaryButton { text: "I checked: the task exists"; enabled: !root.busy; clicked => { root.reconcile-reminder(true); } }
                                            SecondaryButton { text: "I checked: no task was created"; enabled: !root.busy; clicked => { root.reconcile-reminder(false); } }
                                        }
                                    }
                                    VerticalLayout { width: 100%; spacing: Tokens.space-3; alignment: start;
                                        HorizontalLayout { spacing: Tokens.space-2;
                                            Text { text: "Why this was suggested"; color: Tokens.text-1; font-size: Tokens.font-16; font-weight: 600; vertical-alignment: center; }
                                            Text { text: "Exact quotations resolved against the source mail. Quoted history is context, not evidence."; color: Tokens.text-2; font-size: Tokens.font-13; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                                        }
                                        for evidence in root.evidence-cards: Rectangle { width: 100%; background: Tokens.bg-surface; border-color: Tokens.stroke-1; border-width: Tokens.hairline; border-radius: Tokens.radius-6; clip: true;
                                            VerticalLayout { spacing: 0px; alignment: start;
                                                Rectangle { background: Tokens.bg-bar;
                                                    HorizontalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-2;
                                                        Text { text: evidence.label; color: Tokens.brand-label; font-size: Tokens.font-13; font-weight: 600; }
                                                        Text { text: "· " + evidence.sender + " · " + evidence.time; color: Tokens.text-2; font-size: Tokens.font-13; horizontal-stretch: 1; wrap: word-wrap; }
                                                        if !evidence.url.is-empty: LinkButton { text: "Open message in Outlook"; enabled: !root.busy; clicked => { root.open-external(evidence.url); } }
                                                    }
                                                }
                                                Rectangle { height: Tokens.hairline; background: Tokens.stroke-1; }
                                                VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-3; padding-bottom: Tokens.space-3; spacing: Tokens.space-2; alignment: start;
                                                    if !evidence.subject-note.is-empty: WrappedText { text: evidence.subject-note; color: Tokens.text-2; size: Tokens.font-11; }
                                                    if !evidence.quote.is-empty: HorizontalLayout { width: 100%; spacing: Tokens.space-3;
                                                        Rectangle { width: Tokens.review-row-bar-width; background: Tokens.brand; }
                                                        WrappedText { text: evidence.quote; color: Tokens.text-1; size: Tokens.font-15; horizontal-stretch: 1; }
                                                    }
                                                    if !evidence.context.is-empty: WrappedText { text: evidence.context; color: Tokens.text-2; size: Tokens.font-13; }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout { width: 100%; spacing: Tokens.space-2; alignment: start;
                                        // N2: the heading names the card below it; with no card
                                        // (`state != "evidence"`) the grey note stands alone rather
                                        // than being introduced by a heading with nothing under it.
                                        if root.completion-card.state == "evidence": WrappedText { text: "Possible later completion"; color: Tokens.text-1; size: Tokens.font-16; weight: 600; }
                                        if root.completion-card.state == "evidence": Rectangle { width: 100%; background: Tokens.success-bg; border-color: Tokens.success-stroke; border-width: Tokens.hairline; border-radius: Tokens.radius-6; clip: true;
                                            VerticalLayout { spacing: 0px; alignment: start;
                                                Rectangle { background: Tokens.bg-bar;
                                                    VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-2; padding-bottom: Tokens.space-2; spacing: Tokens.space-1; alignment: start;
                                                        HorizontalLayout { spacing: Tokens.space-2;
                                                            Text { text: root.completion-card.label; color: Tokens.success; font-size: Tokens.font-13; font-weight: 600; }
                                                            Text { text: "· " + root.completion-card.sender + " · " + root.completion-card.time; color: Tokens.text-2; font-size: Tokens.font-13; horizontal-stretch: 1; wrap: word-wrap; }
                                                        }
                                                        HorizontalLayout { spacing: Tokens.space-2;
                                                            Rectangle { horizontal-stretch: 1; }
                                                            if root.completion-card.cross-thread: Pill { text: "evidence in another conversation"; kind: "success"; }
                                                            if !root.completion-card.url.is-empty: LinkButton { text: "Open message in Outlook"; enabled: !root.busy; clicked => { root.open-external(root.completion-card.url); } }
                                                        }
                                                    }
                                                }
                                                Rectangle { height: Tokens.hairline; background: Tokens.stroke-1; }
                                                VerticalLayout { padding-left: Tokens.space-4; padding-right: Tokens.space-4; padding-top: Tokens.space-3; padding-bottom: Tokens.space-3; spacing: Tokens.space-2; alignment: start;
                                                    HorizontalLayout { width: 100%; spacing: Tokens.space-3;
                                                        Rectangle { width: Tokens.review-row-bar-width; background: Tokens.success; }
                                                        WrappedText { text: root.completion-card.quote; color: Tokens.text-1; size: Tokens.font-15; horizontal-stretch: 1; }
                                                    }
                                                    WrappedText { text: "Completion is a hypothesis for you to confirm; it is never treated as final."; color: Tokens.text-2; size: Tokens.font-11; }
                                                }
                                            }
                                        }
                                        if root.completion-card.state != "evidence": WrappedText { text: root.completion-card.label; color: Tokens.text-3; size: Tokens.font-13; }
                                    }
                                    Disclosure { title: root.conversation-title; expanded: root.conversation-expanded-default; enabled: !root.busy;
                                        VerticalLayout { width: 100%; spacing: Tokens.space-3; alignment: start;
                                            for message in root.conversation-rows: Rectangle { width: 100%; background: message.sent ? Tokens.brand-panel : Tokens.bg-surface; border-color: Tokens.stroke-1; border-width: Tokens.hairline; border-radius: Tokens.radius-4;
                                                HorizontalLayout { padding-left: Tokens.space-3; padding-right: Tokens.space-3; padding-top: Tokens.space-3; padding-bottom: Tokens.space-3; spacing: Tokens.space-3;
                                                    Avatar { initials: message.initials; accessible-name: message.sender; }
                                                    VerticalLayout { horizontal-stretch: 1; spacing: Tokens.space-1; alignment: start;
                                                        WrappedText { text: message.sender; color: Tokens.text-1; weight: 600; }
                                                        WrappedText { text: message.meta; color: Tokens.text-2; size: Tokens.font-11; }
                                                        WrappedText { text: message.body; color: Tokens.text-1; }
                                                        if !message.quoted-history.is-empty: Disclosure { title: "Quoted history"; enabled: !root.busy;
                                                            WrappedText { text: message.quoted-history; color: Tokens.text-2; size: Tokens.font-13; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
